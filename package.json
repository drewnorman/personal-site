{
  "name": "personal-site",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "test": "yarn build",
    "podman:dev": "podman compose -f compose.yml up",
    "firebase:preview": "firebase hosting:channel:deploy preview --expires 7d",
    "firebase:deploy": "firebase deploy --only hosting"
  },
  "dependencies": {
    "astro": "^5.8.1",
    "gsap": "^3.13.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@tailwindcss/container-queries": "^0.1.1",
    "autoprefixer": "^10.4.20",
    "firebase-tools": "^14.5.1",
    "fluid-tailwind": "^1.0.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "yarn@1.22.22"
}
