---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Drew Norman | Full Stack Developer';
const description = "I'm Drew Norman, a full stack developer specializing in functional programming and cloud-native technologies.";

const codeLinks = [
  {
    href: 'https://github.com/drewnorman/',
    label: 'GitHub',
  },
  {
    href: 'https://gitlab.com/drewnorman/',
    label: 'GitLab',
  },
  {
    href: 'https://linkedin.com/in/drew-norman-dev/',
    label: 'LinkedIn',
  },
];
---

<BaseLayout title={title} description={description}>
  <main class="grid min-h-screen w-full place-items-center box-border px-4 py-8 md:py-12" aria-labelledby="intro-title">
    <section class="@container w-full max-w-[46rem] text-center" data-animate-root>
      <div class="mx-auto mb-4 aspect-square ~w-56/80 ~h-56/80 overflow-hidden rounded-full" data-animate="portrait">
        <img
          class="block size-full rounded-full border-4 border-site-text object-cover"
          src="/images/drew.jpg"
          alt="Drew Norman"
          width="680"
          height="680"
        />
      </div>

      <h1 id="intro-title" class="m-0 whitespace-nowrap font-display ~text-5xl/6xl font-normal leading-none" data-animate="name">Drew Norman</h1>
      <p class="mt-1 mb-0 whitespace-nowrap font-heading ~text-xl/2xl font-normal leading-tight" data-animate="career">Full Stack Developer</p>

      <div class="mx-auto mt-8 max-w-[44rem] ~text-lg/xl leading-relaxed" data-animate="details">
        <p class="my-3 @md:my-4">
          I'm into
          <a href="https://en.wikipedia.org/wiki/Functional_programming" target="_blank" rel="noopener noreferrer">
            functional programming
          </a>
          and
          <a href="https://landscape.cncf.io/" target="_blank" rel="noopener noreferrer">
            cloud-native technologies
          </a>.
        </p>
        <p class="my-3 @md:my-4">
          I like growing
          <a href="/images/ghost-peppers.jpg" target="_blank" rel="noopener noreferrer">
            super hots
          </a>,
          watching
          <a href="https://www.imdb.com/title/tt0078748/" target="_blank" rel="noopener noreferrer">
            scary movies
          </a>,
          and chilling with
          <a href="/images/cats.jpg" target="_blank" rel="noopener noreferrer">
            my cats
          </a>.
        </p>
        <p class="my-3 @md:my-4">
          I currently work at
          <a href="https://foxfuelcreative.com/" target="_blank" rel="noopener noreferrer">
            FoxFuel Creative
          </a>.
        </p>
        <p class="my-3 @md:my-4">
          Feel free to check out
          <a href="/documents/Drew Norman - Resume.pdf" target="_blank">
            my resume
          </a>
          or see my recent activity below.
        </p>
      </div>

      <nav class="flex flex-wrap justify-center gap-x-5 gap-y-3 pt-5" aria-label="Profiles" data-animate="links">
        {codeLinks.map((link) => (
          <a class="font-heading ~text-lg/xl font-normal text-site-text opacity-80 transition-opacity duration-200 ease-in-out hover:opacity-100 focus-visible:opacity-100" href={link.href} target="_blank" rel="noopener noreferrer">
            {link.label}
          </a>
        ))}
      </nav>
    </section>
  </main>
</BaseLayout>

<script>
  import { gsap } from 'gsap';

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduceMotion) {
    const timeline = gsap.timeline({ defaults: { duration: 0.6, ease: 'power2.out' } });

    timeline
      .from('[data-animate="portrait"]', { autoAlpha: 0, scale: 0.95, delay: 0.1 })
      .from('[data-animate="name"]', { autoAlpha: 0, x: -15 }, '-=0.35')
      .from('[data-animate="career"]', { autoAlpha: 0, x: 5 }, '-=0.45')
      .from('[data-animate="details"]', { autoAlpha: 0, y: 40 }, '-=0.35')
      .from('[data-animate="links"] a', { autoAlpha: 0, y: 48, stagger: 0.1 }, '-=0.2');
  }
</script>
